# One effect mechanism: mutable state as an effect + a handler.
effect state
  get() -> Int
  put(Int) -> Unit

# run_state is a handler: it threads the state through the resumption.
fn run_state(init, thunk) =
  let h = handle thunk()
    get(k) -> fn s -> k(s)(s)
    put(s2, k) -> fn s -> k(Unit)(s2)
    return(x) -> fn s -> x
  h(init)

fn count_down(n) =
  if n <= 0 then get()
  else
    put(get() + n)
    count_down(n - 1)

# `sum_to` is PURE to the outside (local effect masking): it uses `state`
# internally, but the handler discharges it before returning.
fn sum_to(n) = run_state(0, fn () -> count_down(n))

println(int_to_str(sum_to(10)))
println(int_to_str(sum_to(100)))

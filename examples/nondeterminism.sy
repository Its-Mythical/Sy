# Multi-shot handlers: the resumption `k` is called twice, so one computation
# explores both branches. This is the Control-lane case.
effect amb
  flip() -> Bool

fn all_results(thunk) =
  handle thunk()
    flip(k) -> append(k(True), k(False))
    return(x) -> Cons(x, Nil)

fn pick(a, b) = if flip() then a else b

# every combination of two coin flips
fn combos() = pick(10, 20) + pick(1, 2)

println(show_list(all_results(combos)))

# a small search by backtracking
fn small() = pick(1, 2) + (pick(3, 4) + pick(5, 6))
println(show_list(all_results(small)))

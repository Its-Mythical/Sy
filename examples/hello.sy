# Basics: strict core, data, pattern matching, first-class constructors.
println("hello, SY")

fn double(x) = x * 2
println(int_to_str(double(21)))

data Shape = Circle(Int) | Rect(Int, Int)

fn area(s) =
  match s
    Circle(r) -> 3 * (r * r)      # integer "pi" keeps this simple
    Rect(w, h) -> w * h

println(int_to_str(area(Rect(6, 7))))

# constructors are ordinary values: Cons is just a function
let xs = map(range(1, 6), double)
println(show_list(xs))
println(int_to_str(sum(xs)))
show_list(reverse(xs))

# Errors are not a separate subsystem: `throw` is an effect like any other.
fn safe_div(a, b) =
  if b == 0 then throw("division by zero") else a / b

fn show_result(r) =
  match r
    Ok(n) -> "ok: " ++ int_to_str(n)
    Err(m) -> "error: " ++ m

println(show_result(catch(fn () -> safe_div(84, 2))))
println(show_result(catch(fn () -> safe_div(1, 0))))

# the exception short-circuits: the second println never runs
fn noisy() =
  println("before")
  throw("boom")
  println("after")

fn attempt() =
  noisy()
  0

println(show_result(catch(attempt)))

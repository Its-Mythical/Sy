;; Errors are not a separate subsystem: `throw` is an effect like any other.
(def safe-div
  (fn (a b)
    (if (== b 0)
        (throw "division by zero")
        (/ a b))))

(def show-result
  (fn (r)
    (case r
      ((Ok n)  (++ "ok: " (int->str n)))
      ((Err m) (++ "error: " m)))))

(println (show-result (catch (fn () (safe-div 84 2)))))
(println (show-result (catch (fn () (safe-div 1 0)))))

;; the exception short-circuits: the second println never runs
(def noisy
  (fn ()
    (do (println "before")
        (throw "boom")
        (println "after"))))

(println (show-result (catch (fn () (do (noisy) 0)))))
